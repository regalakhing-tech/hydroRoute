APP_NAME="HydroRoute"
APP_ENV=local
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

# Copy the project URL and publishable key from your Supabase project.
# Leave these empty until the project is available.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key (Project Settings > API Keys > Secret keys).
# Used only to create a customer account after the email code is verified. Never commit it.
SUPABASE_SECRET_KEY=

# true = sample data and no logins (demos and automated page tests only).
APP_PREVIEW=false

# PHPMailer SMTP. Gmail: smtp.gmail.com, port 587, tls, and a Google App Password
# (Google Account > Security > 2-Step Verification > App passwords).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="HydroRoute"
